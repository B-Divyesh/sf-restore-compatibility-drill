{
  "name": "restore-compatibility-drill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build:cli": "cargo build --release",
    "build:site": "vite build --config site/vite.config.ts && node scripts/postbuild.mjs",
    "build": "npm run build:cli && npm run build:site",
    "typecheck": "tsc --noEmit",
    "test": "cargo test && npm run typecheck && npm run build:site && playwright test",
    "test:claims": "playwright test --grep @claim:",
    "preview": "vite preview --config site/vite.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.2",
    "vite": "^7.3.6"
  }
}
